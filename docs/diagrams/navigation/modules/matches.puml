@startuml MatchdayMatchesNavigation
title Navegación interna - Partidos

left to right direction
skinparam linetype ortho

rectangle "Calendario\n/" as List
rectangle "Favoritos\n/" as Favorites
rectangle "Detalle\n/matches/:id" as Detail
rectangle "Crear partido\n/matches/create" as Create
rectangle "Panel de partido\n/matches/manage/:id" as Manage

List --> Detail : abrir tarjeta
Favorites --> Detail : abrir favorito
Detail --> List : volver
Detail --> Manage : operar
Create --> Manage : partido creado
Manage --> Detail : consultar acta
Manage --> List : volver al calendario

note bottom of List
  Calendario y favoritos comparten ruta;
  cambia solamente el filtro activo.
end note
@enduml
